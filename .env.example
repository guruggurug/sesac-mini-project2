# Application
APP_ENV=development
APP_NAME=semiconductor-value-navigation
DATA_MODE=sample

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8000

# Data paths
ESG_DATA_PATH=data/processed/esg_indicators.csv
EVENT_DATA_PATH=data/processed/events.csv
SOURCE_DATA_PATH=data/processed/sources.csv
PRICE_DATA_PATH=data/processed/stock_prices.csv

SAMPLE_ESG_DATA_PATH=data/sample/esg_indicators.sample.csv
SAMPLE_EVENT_DATA_PATH=data/sample/events.sample.csv
SAMPLE_PRICE_DATA_PATH=data/sample/stock_prices.sample.csv
SAMPLE_OPTIMIZATION_RESULT_PATH=data/sample/optimization-result.sample.json

# External APIs
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_TIMEOUT_SECONDS=5
DART_MAX_ATTEMPTS=3
DART_RETRY_BACKOFF_SECONDS=0.25
NEWS_API_KEY=
GEMINI_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_MIN_REQUEST_INTERVAL_SECONDS=1.0
RUNTIME_STATE_DB_PATH=data/runtime/state.db
ISSUE_RUNTIME_DATA_DIR=data/runtime/issues

# Optional runtime settings
LOG_LEVEL=INFO
ENABLE_DATA_REFRESH=false
ENABLE_SAMPLE_FALLBACK=true
ENABLE_ISSUE_SCHEDULER=false
ISSUE_SYNC_HOUR_KST=4
ISSUE_SYNC_MINUTE_KST=0
MARKET_QUOTE_CACHE_TTL_SECONDS=15
MARKET_QUOTE_TIMEOUT_SECONDS=5
MARKET_REFRESH_INTERVAL_SECONDS=15
