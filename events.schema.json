{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/data/events.schema.json",
  "title": "ESG Events CSV Row",
  "description": "삼성전자와 SK하이닉스 ESG·준법 사건 CSV의 행 단위 검증 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "company_id",
    "company_name",
    "event_category",
    "event_subcategory",
    "event_date",
    "event_date_type",
    "business_unit",
    "status",
    "severity",
    "authority_confirmed",
    "official_source_url",
    "news_url",
    "summary",
    "review_status",
    "note"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{4}$"
    },
    "company_id": {
      "type": "string",
      "enum": [
        "005930",
        "000660"
      ]
    },
    "company_name": {
      "type": "string",
      "enum": [
        "삼성전자",
        "SK하이닉스"
      ]
    },
    "event_category": {
      "type": "string",
      "enum": [
        "greenhouse_gas_energy",
        "water",
        "hazardous_chemicals",
        "waste_circularity",
        "occupational_safety",
        "human_capital_labor",
        "supply_chain_human_rights",
        "product_quality",
        "cybersecurity",
        "board_independence",
        "accounting_disclosure",
        "fair_trade_compliance",
        "export_control",
        "technology_protection",
        "other"
      ]
    },
    "event_subcategory": {
      "type": "string",
      "minLength": 1
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_date_type": {
      "type": "string",
      "enum": [
        "occurrence_date",
        "official_disclosure_date",
        "authority_announcement_date",
        "first_public_report_date",
        "sanction_date",
        "resolution_date"
      ]
    },
    "business_unit": {
      "type": "string",
      "enum": [
        "DS",
        "semiconductor",
        "domestic_site",
        "consolidated",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "rumor",
        "reported",
        "confirmed",
        "sanctioned",
        "resolved"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "authority_confirmed": {
      "type": "boolean"
    },
    "official_source_url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "news_url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "sanctioned",
              "resolved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "authority_confirmed": {
            "const": true
          },
          "official_source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "rumor",
              "reported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "authority_confirmed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "examples": [
    {
      "event_id": "EVT-0001",
      "company_id": "000660",
      "company_name": "SK하이닉스",
      "event_category": "occupational_safety",
      "event_subcategory": "workplace_accident",
      "event_date": "2024-03-15",
      "event_date_type": "first_public_report_date",
      "business_unit": "semiconductor",
      "status": "confirmed",
      "severity": 4,
      "authority_confirmed": true,
      "official_source_url": "https://example.com/official",
      "news_url": "https://example.com/news",
      "summary": "반도체 사업장 안전사고",
      "review_status": "approved",
      "note": "공식 발표와 기사 교차검증 완료"
    }
  ]
}