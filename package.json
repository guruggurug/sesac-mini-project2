{
  "name": "chip-buddy-frontend",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run css:build",
    "css:build": "tailwindcss -i ./src/frontend/assets/css/app.css -o ./src/frontend/static/css/index.css --minify",
    "css:watch": "tailwindcss -i ./src/frontend/assets/css/app.css -o ./src/frontend/static/css/index.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17"
  }
}
