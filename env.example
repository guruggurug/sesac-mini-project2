# Application
APP_ENV=development
APP_NAME=semiconductor-value-navigation
DATA_MODE=sample

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8000

# Data paths
ESG_DATA_PATH=data/processed/esg_indicators.csv
EVENT_DATA_PATH=data/processed/events.csv
SOURCE_DATA_PATH=data/processed/sources.csv
PRICE_DATA_PATH=data/processed/stock_prices.csv

SAMPLE_ESG_DATA_PATH=data/sample/esg_indicators.sample.csv
SAMPLE_EVENT_DATA_PATH=data/sample/events.sample.csv
SAMPLE_PRICE_DATA_PATH=data/sample/stock_prices.sample.csv
SAMPLE_OPTIMIZATION_RESULT_PATH=data/sample/optimization-result.sample.json

# External APIs
DART_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=

# Optional runtime settings
LOG_LEVEL=INFO
ENABLE_DATA_REFRESH=false
ENABLE_SAMPLE_FALLBACK=true
