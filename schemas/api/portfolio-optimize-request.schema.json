{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/api/portfolio-optimize-request.schema.json",
  "title": "Portfolio Optimize Request",
  "description": "삼성전자와 SK하이닉스 포트폴리오 최적화 요청 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "holdings",
    "risk_priority"
  ],
  "properties": {
    "holdings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "quantity",
          "average_price"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "enum": [
              "005930",
              "000660"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "average_price": {
            "type": "number",
            "minimum": 0
          },
          "buy_reason": {
            "type": "string",
            "maxLength": 500,
            "default": ""
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "ticker": {
            "const": "005930"
          }
        },
        "required": [
          "ticker"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "risk_priority": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "esg_focused"
      ]
    },
    "current_prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "005930": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "000660": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "005930",
        "000660"
      ]
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "sample",
        "validated",
        "fallback"
      ],
      "default": "sample"
    }
  },
  "allOf": [
    {
      "properties": {
        "holdings": {
          "contains": {
            "type": "object",
            "properties": {
              "ticker": {
                "const": "000660"
              }
            },
            "required": [
              "ticker"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "not": {
        "properties": {
          "holdings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quantity": {
                  "const": 0
                }
              },
              "required": [
                "quantity"
              ]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "holdings": [
        {
          "ticker": "005930",
          "quantity": 70,
          "average_price": 70000,
          "buy_reason": "장기 보유"
        },
        {
          "ticker": "000660",
          "quantity": 30,
          "average_price": 180000,
          "buy_reason": "반도체 업황 회복 기대"
        }
      ],
      "risk_priority": "balanced",
      "current_prices": {
        "005930": 78000,
        "000660": 195000
      },
      "data_mode": "sample"
    }
  ]
}
