{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/data/esg-indicators.schema.json",
  "title": "ESG Indicators CSV Row",
  "description": "삼성전자와 SK하이닉스 ESG 지표 CSV의 행 단위 검증 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "company_name",
    "indicator_id",
    "category",
    "indicator_name",
    "raw_value",
    "raw_unit",
    "period",
    "business_scope",
    "geography",
    "source_id",
    "source_title",
    "source_page",
    "source_url",
    "source_table_title",
    "source_text",
    "assurance",
    "scope_mismatch",
    "availability",
    "data_confidence",
    "risk_direction",
    "review_status",
    "note",
    "target_value",
    "target_unit",
    "target_year",
    "baseline_value",
    "baseline_year",
    "target_source_id"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "enum": [
        "005930",
        "000660"
      ]
    },
    "company_name": {
      "type": "string",
      "enum": [
        "삼성전자",
        "SK하이닉스"
      ]
    },
    "indicator_id": {
      "type": "string",
      "pattern": "^[ESG][0-9]{2}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "E",
        "S",
        "G"
      ]
    },
    "indicator_name": {
      "type": "string",
      "minLength": 1
    },
    "raw_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_unit": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^(19|20)[0-9]{2}(-Q[1-4])?$"
    },
    "business_scope": {
      "type": "string",
      "enum": [
        "DS",
        "semiconductor",
        "domestic_site",
        "consolidated",
        "unknown"
      ]
    },
    "geography": {
      "type": "string",
      "enum": [
        "Korea",
        "global",
        "mixed",
        "unknown"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[0-9]{4}$"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_page": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "assurance": {
      "type": "string",
      "enum": [
        "third_party_assured",
        "internally_verified",
        "not_assured",
        "unknown"
      ]
    },
    "scope_mismatch": {
      "type": "boolean"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "risk_direction": {
      "type": "string",
      "enum": [
        "higher_is_worse",
        "higher_is_better",
        "event_based",
        "qualitative"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected"
      ]
    },
    "note": {
      "type": "string"
    },
    "source_table_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "target_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_year": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "baseline_year": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_source_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "raw_value": {
            "type": "number"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "raw_value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "company_id": {
            "const": "005930"
          },
          "business_scope": {
            "const": "consolidated"
          }
        }
      },
      "then": {
        "properties": {
          "scope_mismatch": {
            "const": true
          }
        }
      }
    }
  ],
  "examples": [
    {
      "company_id": "005930",
      "company_name": "삼성전자",
      "indicator_id": "E01",
      "category": "E",
      "indicator_name": "온실가스 배출집약도",
      "raw_value": 12.4,
      "raw_unit": "tCO2e/억원",
      "period": "2024",
      "business_scope": "DS",
      "geography": "global",
      "source_id": "SRC-0001",
      "source_title": "삼성전자 DS 지속가능경영보고서",
      "source_page": 73,
      "source_url": "https://example.com/report.pdf",
      "source_table_title": "온실가스 배출집약도",
      "source_text": "2024년 온실가스 배출집약도는 12.4 tCO2e/억원입니다.",
      "assurance": "third_party_assured",
      "scope_mismatch": false,
      "availability": "available",
      "data_confidence": "high",
      "risk_direction": "higher_is_worse",
      "review_status": "approved",
      "note": "원문 확인 완료",
      "target_value": 10.0,
      "target_unit": "tCO2e/억원",
      "target_year": "2030",
      "baseline_value": 15.0,
      "baseline_year": "2018",
      "target_source_id": "SRC-0001"
    }
  ]
}