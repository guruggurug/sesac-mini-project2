{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/data/events.schema.json",
  "title": "ESG Events CSV Row",
  "description": "삼성전자와 SK하이닉스 ESG·준법 사건 CSV의 행 단위 검증 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "company_id",
    "company_name",
    "event_category",
    "event_subcategory",
    "event_date",
    "event_date_type",
    "business_unit",
    "detection_source_type",
    "status",
    "enforcement_action",
    "severity",
    "severity_rule_version",
    "authority_confirmed",
    "official_source_url",
    "news_url",
    "summary",
    "note",
    "linked_indicator_id",
    "severity_evidence",
    "responsibility_evidence",
    "persistence_evidence",
    "evidence_confidence",
    "resolved_date",
    "market_event_date",
    "market_event_date_type"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{4}$"
    },
    "company_id": {
      "type": "string",
      "enum": [
        "005930",
        "000660"
      ]
    },
    "company_name": {
      "type": "string",
      "enum": [
        "삼성전자",
        "SK하이닉스"
      ]
    },
    "event_category": {
      "type": "string",
      "enum": [
        "greenhouse_gas_energy",
        "water",
        "hazardous_chemicals",
        "waste_circularity",
        "occupational_safety",
        "human_capital_labor",
        "supply_chain_human_rights",
        "product_quality",
        "cybersecurity",
        "board_independence",
        "accounting_disclosure",
        "fair_trade_compliance",
        "export_control",
        "technology_protection",
        "other"
      ]
    },
    "event_subcategory": {
      "type": "string",
      "minLength": 1
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_date_type": {
      "type": "string",
      "enum": [
        "occurrence_date",
        "official_disclosure_date",
        "authority_announcement_date",
        "first_public_report_date",
        "sanction_date",
        "resolution_date"
      ]
    },
    "business_unit": {
      "type": "string",
      "enum": [
        "DS",
        "semiconductor",
        "domestic_site",
        "consolidated",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "confirmed",
        "resolved"
      ]
    },
    "detection_source_type": {
      "type": "string",
      "enum": [
        "dart_disclosure",
        "news"
      ]
    },
    "enforcement_action": {
      "type": "string",
      "enum": [
        "no_action",
        "investigation",
        "corrective_order",
        "fine",
        "sanctioned"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "severity_rule_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "authority_confirmed": {
      "type": "boolean"
    },
    "official_source_url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "news_url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "note": {
      "type": "string"
    },
    "linked_indicator_id": {
      "type": "string",
      "pattern": "^[ESG][0-9]{2}$"
    },
    "severity_evidence": {
      "type": "string"
    },
    "responsibility_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "persistence_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "resolved_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_event_date": {
      "type": "string",
      "format": "date"
    },
    "market_event_date_type": {
      "type": "string",
      "enum": [
        "occurrence_date",
        "official_disclosure_date",
        "authority_announcement_date",
        "first_public_report_date",
        "sanction_date",
        "resolution_date"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "resolved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "authority_confirmed": {
            "const": true
          },
          "official_source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "reported"
          }
        }
      },
      "then": {
        "properties": {
          "authority_confirmed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "resolved_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["reported", "confirmed"]
          }
        }
      },
      "then": {
        "properties": {
          "resolved_date": {
            "type": "null"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "event_id": "EVT-0001",
      "company_id": "000660",
      "company_name": "SK하이닉스",
      "event_category": "occupational_safety",
      "event_subcategory": "workplace_accident",
      "event_date": "2024-03-15",
      "event_date_type": "first_public_report_date",
      "business_unit": "semiconductor",
      "detection_source_type": "news",
      "status": "confirmed",
      "enforcement_action": "investigation",
      "severity": 4,
      "severity_rule_version": "1.0.0",
      "authority_confirmed": true,
      "official_source_url": "https://example.com/official",
      "news_url": "https://example.com/news",
      "summary": "반도체 사업장 안전사고",
      "note": "공식 발표와 기사 교차검증 완료",
      "linked_indicator_id": "S01",
      "severity_evidence": "고용노동부 조사 및 조치 사항에 근거하여 4점 산정",
      "responsibility_evidence": "해당 정비 작업 시 관리자 부재",
      "persistence_evidence": "일주일 내 개선 완료",
      "evidence_confidence": "high",
      "resolved_date": null,
      "market_event_date": "2024-03-15",
      "market_event_date_type": "first_public_report_date"
    }
  ]
}
