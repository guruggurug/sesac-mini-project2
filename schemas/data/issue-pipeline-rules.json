{
  "version": "1.1.0",
  "automated_validation": {
    "required_contracts": ["event-candidates", "sources", "event-sources", "events"],
    "publishable_candidate_statuses": ["validated"],
    "model_eligible_event_statuses": ["confirmed", "resolved"],
    "required_primary_source_role": "official_confirmation",
    "primary_source_count_per_event": 1,
    "official_domains": [
      "samsung.com",
      "images.samsung.com",
      "skhynix.com",
      "nssc.go.kr",
      "moel.go.kr",
      "pipc.go.kr",
      "krx.co.kr",
      "dart.fss.or.kr"
    ],
    "failure_action": "retain_rejected_candidate"
  },
  "candidate_classification": {
    "version": "1.0.0",
    "unmatched_action": "reject",
    "unmatched_reason": "no_approved_esg_event_rule_match",
    "official_dart_status": "confirmed",
    "rules": [
      {
        "rule_id": "OCCUPATIONAL_SAFETY",
        "pattern": "중대재해\\s*발생|산업재해|업무상\\s*질병|사망\\s*사고",
        "body_pattern": "중대재해\\s*발생|산업재해\\s*(?:발생|사고)|업무상\\s*질병.{0,80}(?:사망|발생)|사망\\s*사고",
        "event_category": "occupational_safety",
        "event_subcategory": "workplace_incident",
        "linked_indicator_id": "S01"
      },
      {
        "rule_id": "HAZARDOUS_CHEMICAL_RELEASE",
        "pattern": "유해화학물질.*(?:누출|유출)|(?:누출|유출).*유해화학물질",
        "body_pattern": "유해화학물질.{0,120}(?:누출|유출)|(?:누출|유출).{0,120}유해화학물질",
        "event_category": "hazardous_chemicals",
        "event_subcategory": "chemical_release",
        "linked_indicator_id": "E05"
      },
      {
        "rule_id": "PERSONAL_DATA_BREACH",
        "pattern": "개인정보.*(?:유출|침해)|(?:유출|침해).*개인정보",
        "body_pattern": "개인정보.{0,120}(?:유출|침해)|(?:유출|침해).{0,120}개인정보",
        "event_category": "cybersecurity",
        "event_subcategory": "personal_data_breach",
        "linked_indicator_id": "S04"
      },
      {
        "rule_id": "GHG_EMISSIONS",
        "pattern": "온실가스.*(?:위반|배출)|공정가스.*(?:위반|배출)",
        "body_pattern": "(?:온실가스|공정가스).{0,120}(?:법령\\s*위반|기준\\s*초과|행정처분|제재|사고)",
        "event_category": "greenhouse_gas_energy",
        "event_subcategory": "emissions",
        "linked_indicator_id": "E01"
      },
      {
        "rule_id": "WASTE_COMPLIANCE",
        "pattern": "폐기물.*(?:위반|처분)|(?:위반|처분).*폐기물",
        "body_pattern": "폐기물.{0,120}(?:법령\\s*위반|행정처분|제재)|(?:법령\\s*위반|행정처분|제재).{0,120}폐기물",
        "event_category": "waste_circularity",
        "event_subcategory": "waste_compliance",
        "linked_indicator_id": "E03"
      },
      {
        "rule_id": "FAIR_TRADE_COMPLIANCE",
        "pattern": "불공정거래|공정거래.*(?:제재|과징금)|횡령|배임",
        "body_pattern": "불공정거래|공정거래.{0,120}(?:제재|과징금)|횡령|배임",
        "event_category": "fair_trade_compliance",
        "event_subcategory": "compliance_action",
        "linked_indicator_id": "G03"
      },
      {
        "rule_id": "ACCOUNTING_DISCLOSURE",
        "pattern": "회계처리기준.*위반|감사보고서.*정정",
        "body_pattern": "회계처리기준.{0,120}위반|감사보고서.{0,120}정정",
        "event_category": "accounting_disclosure",
        "event_subcategory": "disclosure_correction",
        "linked_indicator_id": "G02"
      }
    ]
  },
  "candidate_deduplication": {
    "key_priority": [
      ["detection_source_type", "source_name", "external_id"],
      ["canonical_url"],
      ["company_id", "content_hash"]
    ],
    "canonical_url": {
      "lowercase_host": true,
      "remove_fragment": true,
      "remove_query_parameters": ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"]
    }
  },
  "source_deduplication": {
    "external_id_key": ["validation_method", "external_id"],
    "fallback_key": ["validation_method", "url", "document_title"]
  },
  "event_deduplication": {
    "identity_fields": ["company_id", "event_category", "linked_indicator_id"],
    "date_field": "market_event_date",
    "date_tolerance_days": 3,
    "text_fields": ["summary", "severity_evidence"],
    "minimum_token_similarity": 0.65,
    "status_precedence": ["reported", "confirmed", "resolved"],
    "enforcement_precedence": ["no_action", "investigation", "corrective_order", "fine", "sanctioned"],
    "merge_policy": {
      "market_event_date": "earliest",
      "resolved_date": "latest_non_null",
      "status": "highest_precedence",
      "enforcement_action": "highest_precedence",
      "sources": "union",
      "severity": "recalculate"
    },
    "conflict_fields": ["company_id", "event_category", "linked_indicator_id"],
    "conflict_action": "reject_new_candidate"
  },
  "severity": {
    "method": "maximum_rule_score",
    "default_score": 1,
    "maximum_score": 5,
    "text_fields": ["summary", "severity_evidence", "responsibility_evidence", "persistence_evidence"],
    "enforcement_base_score": {
      "no_action": 1,
      "investigation": 2,
      "corrective_order": 3,
      "fine": 3,
      "sanctioned": 4
    },
    "keyword_rules": [
      {
        "score": 5,
        "keywords": ["사망", "공장 전체 셧다운", "사업장 폐쇄", "형사 기소"]
      },
      {
        "score": 4,
        "keywords": ["중상", "다수 부상", "다수 작업자", "방사선 피폭", "조업 정지", "대규모 유출", "핵심기술 유출"]
      },
      {
        "score": 3,
        "keywords": ["시정명령", "과징금", "과태료", "화학물질 누출", "개인정보 유출"]
      },
      {
        "score": 2,
        "keywords": ["경고", "집중점검", "일시 지연", "경미"]
      }
    ],
    "negated_keyword_phrases": {
      "사망": [
        "사망 없음",
        "사망자는 없음",
        "사망자는 없",
        "사망자 없음",
        "사망하지 않음",
        "사망으로 이어지지 않음",
        "사망 사고는 없음"
      ]
    },
    "no_match_action": "use_enforcement_base_or_default"
  }
}
